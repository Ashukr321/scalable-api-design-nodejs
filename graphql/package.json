{
  "name": "graphql-blog",
  "version": "1.0.0",
  "description": "GraphQL example: Blog API with queries, mutations, subscriptions, DataLoader and cursor pagination on Node.js, Apollo Server, Express 5 and MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-timeout=10000"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.8",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "mongoose": "^9.12.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
