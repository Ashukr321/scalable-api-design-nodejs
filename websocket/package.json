{
  "name": "websocket-chat",
  "version": "1.0.0",
  "description": "WebSocket example: real-time chat rooms with presence, history and heartbeats on Node.js, Express 5, ws and MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
